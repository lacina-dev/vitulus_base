#!/usr/bin/env python3
"""cmd_vel_mux - a person on the controls always beats the software.

Every velocity command for the wheels goes through this node.  It forwards
exactly one input to the base (`~output`, default /mobile_base_controller/cmd_vel,
the diff_drive controller's own topic) and decides which one by priority:

    ds4     /ds4/cmd_vel       the DS4 gamepad (ds4_twist)              human
    teleop  /teleop/cmd_vel    the web UI joystick (rosbridge), keyboard human
    primitive /drive_primitive/cmd_vel  closed-loop direct drive (vitulus_base
                               drive_primitive: straight / rotate / short
                               velocity, used by the agent)              software
    nav     /cmd_vel           all software: move_base_flex, docking,
                               mower recovery, agent supervisor ...     software

Rules
  * A human input counts only while it is really *deflected*: |linear.x| or
    |angular.z| over the dead zone, or (DS4) a takeover button pressed.  A
    switched-on DS4 publishes zeros at ~250 Hz with centred sticks - those
    zeros are dropped, so a gamepad lying on the table never blocks autonomy.
  * The first deflection starts a TAKEOVER: the software's goals are cancelled
    once (MBF exe_path / move_base / recovery, /smach_goal/cancel,
    /dock_smach/stop, and /mower_smach/stop while a mowing program runs),
    /cmd_vel_mux/takeover names the source.  Drive motors are never switched
    off here.
  * /mower_smach/stop is skipped only when mower_smach says it is idle
    (/mower_smach/busy false and /mower_smach/active_program empty); unknown
    counts as running, so the stop is sent.  A stop sent to an idle mower
    used to queue up behind its blocking blade shutdown and cancel a later
    docking (18. 10. 2026).
  * During the takeover and `~hold_s` after the last deflection the human input
    owns the wheels - its zeros (sticks released) are forwarded, the software
    is dropped.
  * After that a software publisher (told apart by its callerid) that was
    still commanding when the person let go has ignored the cancel: it stays
    blocked - only that node - until it has been quiet (no non-zero command)
    for `~rearm_quiet_s`.  A node that obeyed the cancel, or a new one, drives
    normally on its next goal (someone presses Go).
  * Between software inputs the higher priority wins while it is talking: an
    input that published anything (zeros included) within `~software_hold_s`
    (0.5 s) owns the wheels and every lower software input is dropped (a
    dropped NON-zero command is listed in nav_blocked).  So the closed-loop
    drive_primitive beats MBF/docking on /cmd_vel, and its final zeros hold
    the robot still; 0.5 s after it falls silent /cmd_vel drives again.  The
    human inputs still beat everything, primitive included; a takeover also
    sends True on /drive_primitive/stop.  Without anything on
    /drive_primitive/cmd_vel the mux behaves exactly as before.
  * The node forwards each message as it arrives and never repeats one; when the
    chosen input stops, the controller's cmd_vel_timeout (0.25 s) stops the
    wheels.  When this node is down nothing reaches the base: the robot stands.

Status: /cmd_vel_mux/active (std_msgs/String, latched: ds4 | teleop |
primitive | nav | nav_blocked), /cmd_vel_mux/status (JSON, latched, on change + 1 Hz),
/cmd_vel_mux/takeover (std_msgs/String, one message per takeover).
"""
import json
import threading
import time

import rospy
from actionlib_msgs.msg import GoalID
from geometry_msgs.msg import Twist
from std_msgs.msg import Bool, String

DEFAULT_INPUTS = [
    {'name': 'ds4', 'topic': '/ds4/cmd_vel', 'priority': 100, 'human': True},
    {'name': 'teleop', 'topic': '/teleop/cmd_vel', 'priority': 90, 'human': True},
    {'name': 'primitive', 'topic': '/drive_primitive/cmd_vel', 'priority': 50,
     'human': False},
    {'name': 'nav', 'topic': '/cmd_vel', 'priority': 10, 'human': False},
]
DEFAULT_GOAL_CANCELS = ['/move_base_flex/exe_path/cancel',
                        '/move_base_flex/move_base/cancel',
                        '/move_base_flex/recovery/cancel']
DEFAULT_STOPS = ['/smach_goal/cancel', '/dock_smach/stop', '/mower_smach/stop',
                 '/drive_primitive/stop']
# Stops that make sense only while a mowing program runs (see the docstring).
DEFAULT_PROGRAM_STOPS = ['/mower_smach/stop']
DEFAULT_TAKEOVER_BUTTONS = ['button_ps', 'button_l1', 'button_r1']


def deflected(msg, dz_lin, dz_ang):
    return (abs(msg.linear.x) > dz_lin or abs(msg.linear.y) > dz_lin
            or abs(msg.angular.z) > dz_ang)


class Mux(object):
    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.lock = threading.RLock()
        self.dz_lin = float(rospy.get_param('~deadzone_linear', 0.02))
        self.dz_ang = float(rospy.get_param('~deadzone_angular', 0.05))
        self.hold_s = float(rospy.get_param('~hold_s', 1.5))
        self.rearm_quiet_s = float(rospy.get_param('~rearm_quiet_s', 1.0))
        self.software_hold_s = float(rospy.get_param('~software_hold_s', 0.5))
        self.sw_dropped = {}             # callerid -> monotonic of a non-zero cmd dropped for a higher software input
        self.sw_last_msg = {}            # software input name -> monotonic of its last forwardable msg
        self.cancel_on_takeover = bool(rospy.get_param('~cancel_on_takeover', True))
        self.inputs = list(rospy.get_param('~inputs', DEFAULT_INPUTS))
        goal_cancels = list(rospy.get_param('~goal_cancel_topics', DEFAULT_GOAL_CANCELS))
        stops = list(rospy.get_param('~stop_topics', DEFAULT_STOPS))
        self.buttons = list(rospy.get_param('~takeover_buttons', DEFAULT_TAKEOVER_BUTTONS))

        self.out = rospy.Publisher(rospy.get_param('~output', '/mobile_base_controller/cmd_vel'),
                                   Twist, queue_size=1, tcp_nodelay=True)
        self.pub_active = rospy.Publisher('~active', String, queue_size=1, latch=True)
        self.pub_status = rospy.Publisher('~status', String, queue_size=1, latch=True)
        self.pub_takeover = rospy.Publisher('~takeover', String, queue_size=5)
        self.goal_cancel_pubs = [rospy.Publisher(t, GoalID, queue_size=1) for t in goal_cancels]
        program_stops = set(rospy.get_param('~program_stop_topics', DEFAULT_PROGRAM_STOPS))
        self.stop_pubs = [rospy.Publisher(t, Bool, queue_size=1) for t in stops]
        self.stop_program_only = [rospy.resolve_name(t) in
                                  {rospy.resolve_name(x) for x in program_stops}
                                  for t in stops]
        self.mower_busy = None           # /mower_smach/busy; None = unknown
        self.mower_program = None        # /mower_smach/active_program
        rospy.Subscriber(rospy.get_param('~mower_busy_topic', '/mower_smach/busy'),
                         Bool, self._mower_busy, queue_size=1)
        rospy.Subscriber(rospy.get_param('~mower_program_topic',
                                         '/mower_smach/active_program'),
                         String, self._mower_program, queue_size=1)

        self.human_last_deflect = {}     # name -> monotonic of the last deflected msg
        self.takeover_active = False
        self.takeover_count = 0
        self.last_takeover = None        # {'source', 't'}
        self.session_end = None          # monotonic end of the last human session
        self.nav_last_nonzero = {}       # callerid -> monotonic of its last non-zero cmd
        self.nav_admitted = set()        # callers let back after the last takeover
        self.nav_blocked_now = {}        # callerid -> monotonic of a dropped non-zero cmd
        self.last_forwarded = None       # name of the input forwarded last
        self.active = None
        self.prev_buttons = {}

        for inp in sorted(self.inputs, key=lambda i: -int(i['priority'])):
            rospy.Subscriber(inp['topic'], Twist, self._cb, callback_args=inp,
                             queue_size=1, tcp_nodelay=True)
        ds4_status = rospy.get_param('~ds4_status_topic', '/ds4/status')
        if ds4_status and self.buttons:
            try:
                from ds4_driver.msg import Status
                rospy.Subscriber(ds4_status, Status, self._ds4_status, queue_size=1)
            except ImportError:
                rospy.logwarn('cmd_vel_mux: ds4_driver not available - takeover by '
                              'button off, sticks still take over')
        self._publish_status(force=True)
        rospy.Timer(rospy.Duration(0.1), self._tick)
        rospy.loginfo('cmd_vel_mux: %s -> %s (hold %.1f s, rearm after %.1f s quiet)',
                      ', '.join('%s %s' % (i['name'], i['topic']) for i in self.inputs),
                      self.out.resolved_name, self.hold_s, self.rearm_quiet_s)

    def _mower_busy(self, msg):
        with self.lock:
            self.mower_busy = bool(msg.data)

    def _mower_program(self, msg):
        with self.lock:
            self.mower_program = (msg.data or '').strip()

    def mower_program_running(self):
        """False only when mower_smach is known idle; unknown -> True."""
        with self.lock:
            if self.mower_busy is None:
                return True
            return bool(self.mower_busy) or bool(self.mower_program)

    # -- decisions ----------------------------------------------------------
    def _human_owner(self, now):
        """The highest-priority human input deflected within hold_s, or None."""
        best = None
        for inp in self.inputs:
            if not inp.get('human'):
                continue
            t = self.human_last_deflect.get(inp['name'])
            if t is not None and now - t <= self.hold_s:
                if best is None or int(inp['priority']) > int(best['priority']):
                    best = inp
        return best

    def _software_owner(self, now):
        """The highest-priority software input that talked within
        software_hold_s, or None."""
        best = None
        for inp in self.inputs:
            if inp.get('human'):
                continue
            t = self.sw_last_msg.get(inp['name'])
            if t is not None and now - t <= self.software_hold_s:
                if best is None or int(inp['priority']) > int(best['priority']):
                    best = inp
        return best

    def _start_takeover(self, source, now):
        self.takeover_active = True
        self.takeover_count += 1
        self.last_takeover = {'source': source, 't': rospy.get_time()}
        self.session_end = None
        self.nav_admitted = set()
        rospy.logwarn('cmd_vel_mux: human takeover by %s - software goals cancelled, '
                      'software blocked until released', source)
        self.pub_takeover.publish(String(source))
        if self.cancel_on_takeover:
            for p in self.goal_cancel_pubs:
                p.publish(GoalID())
            mowing = self.mower_program_running()
            for p, program_only in zip(self.stop_pubs, self.stop_program_only):
                if program_only and not mowing:
                    continue
                p.publish(Bool(True))

    def _human_touch(self, name, now):
        with self.lock:
            if self._human_owner(now) is None:
                self._start_takeover(name, now)
            self.human_last_deflect[name] = now

    def _cb(self, msg, inp):
        now = self.clock()
        forward = False
        with self.lock:
            if inp.get('human'):
                if deflected(msg, self.dz_lin, self.dz_ang):
                    self._human_touch(inp['name'], now)
                owner = self._human_owner(now)
                forward = owner is not None and owner['name'] == inp['name']
            else:
                hdr = getattr(msg, '_connection_header', None) or {}
                caller = hdr.get('callerid', '?')
                moving = deflected(msg, self.dz_lin, self.dz_ang)
                self._update_rearm(now)
                forward = self._human_owner(now) is None and self._nav_admit(caller, now)
                if forward:
                    owner = self._software_owner(now)
                    if owner is not None and int(owner['priority']) > int(inp['priority']):
                        forward = False      # a higher software input is driving
                        if moving:
                            self.sw_dropped[caller] = now
                    else:
                        self.sw_last_msg[inp['name']] = now
                if moving:
                    self.nav_last_nonzero[caller] = now
                    if not forward:
                        self.nav_blocked_now[caller] = now
            if forward:
                self.last_forwarded = inp['name']
        if forward:
            self.out.publish(msg)

    def _ds4_status(self, msg):
        now = self.clock()
        pressed = False
        for b in self.buttons:
            v = int(getattr(msg, b, 0) or 0)
            if v and not self.prev_buttons.get(b):
                pressed = True
            self.prev_buttons[b] = v
        if pressed:
            self._human_touch('ds4', now)
            self.out.publish(Twist())   # the button means "stand": stop at once

    def _update_rearm(self, now):
        if self._human_owner(now) is not None:
            return
        if self.takeover_active:
            self.takeover_active = False
            self.session_end = max(self.human_last_deflect.values()) + self.hold_s
            rospy.loginfo('cmd_vel_mux: human released the controls')

    def _nav_admit(self, caller, now):
        """May this software publisher drive?  Always, unless a takeover
        happened and it has not yet been quiet for rearm_quiet_s since."""
        if self.takeover_count == 0 or caller in self.nav_admitted:
            return True
        if self.session_end is None:
            return False                        # the human still has it
        # Quiet = no non-zero command for rearm_quiet_s, either already before
        # the person let go (it obeyed the cancel: a new goal from it is a new
        # goal) or since.  A node still commanding when the person let go has
        # ignored the cancel and waits until it falls silent.
        last = self.nav_last_nonzero.get(caller)
        if (last is None or last <= self.session_end - self.rearm_quiet_s
                or now - last >= self.rearm_quiet_s):
            self.nav_admitted.add(caller)
            self.nav_blocked_now.pop(caller, None)
            rospy.loginfo('cmd_vel_mux: %s quiet for %.1f s after the takeover - accepted',
                          caller, self.rearm_quiet_s)
            return True
        return False

    def _blocked_callers(self, now):
        out = set(c for c, t in self.nav_blocked_now.items()
                  if now - t < 2.0 and c not in self.nav_admitted)
        out.update(c for c, t in self.sw_dropped.items()
                   if now - t < self.software_hold_s + 0.1)
        return sorted(out)

    # -- status -------------------------------------------------------------
    def _state(self, now):
        owner = self._human_owner(now)
        if owner is not None:
            return owner['name']
        sw = self._software_owner(now)
        if sw is not None and sw['name'] != 'nav' and int(sw['priority']) > min(
                int(i['priority']) for i in self.inputs if not i.get('human')):
            return sw['name']
        if self._blocked_callers(now):
            return 'nav_blocked'
        return 'nav'

    def _tick(self, _evt):
        with self.lock:
            self._update_rearm(self.clock())
        self._publish_status()

    def _publish_status(self, force=False):
        now = self.clock()
        with self.lock:
            state = self._state(now)
            changed = state != self.active
            self.active = state
            st = {'active': state, 'takeover': self.takeover_active,
                  'nav_blocked': self._blocked_callers(now),
                  'takeovers': self.takeover_count,
                  'last_takeover': self.last_takeover, 'hold_s': self.hold_s,
                  'rearm_quiet_s': self.rearm_quiet_s}
        if changed or force:
            self.pub_active.publish(String(state))
        self._status_n = getattr(self, '_status_n', 0) + 1
        if changed or force or self._status_n % 10 == 0:
            self.pub_status.publish(String(json.dumps(st, sort_keys=True)))


def main():
    rospy.init_node('cmd_vel_mux')
    Mux()
    rospy.spin()


if __name__ == '__main__':
    main()
