class RobotSpec:
    FRONT_LEFT_ID = 1
    FRONT_RIGHT_ID = 2
    REAR_LEFT_ID = 3
    REAR_RIGHT_ID = 4
    REDUCER = 13
    WHEEL_DIA = 0.21  # meters
    ROTATION_DISTANCE = (WHEEL_DIA * math.pi) / REDUCER
    METER_ROTATION = 1 / ROTATION_DISTANCE
    MOT_RPS_TO_WHEEL_RAD = (2 * math.pi) / REDUCER
    WHEEL_RAD_TO_MOT_RPS = REDUCER / (2 * math.pi)
    TORQUE = 1.538461538  # Nm on motor
    torque_recent = TORQUE


class ControllerState:
    # Mode Constants
    MODE_STOPPED = 0
    MODE_FAULT = 1
    MODE_PWM = 5
    MODE_VOLTAGE = 6
    MODE_VOLTAGE_FOC = 7
    MODE_VOLTAGE_DQ = 8
    MODE_CURRENT = 9
    MODE_POSITION = 10  # Assumed to be the normal operational mode
    MODE_TIMEOUT = 11
    MODE_ZERO_VELOCITY = 12
    MODE_STAY_WITHIN = 13

    # Fault Constants
    FAULT_OK = 0
    FAULT_CALIBRATION = 32
    FAULT_MOTOR_DRV = 33
    FAULT_OVER_VOLTAGE = 34
    FAULT_ENCODER = 35
    FAULT_MOTOR_NOT_CONFG = 36
    FAULT_PWM_CYCLE_OVERRUN = 37
    FAULT_OVER_TEMP = 38
    FAULT_OUTSIDE_LIMIT = 39

    def __init__(self, id):
        self.id = id
        self.stamp = time.time()
        self.mode = ControllerState.MODE_STOPPED
        self.position = 0
        self.velocity = 0
        self.torque = 0
        self.voltage = 0
        self.temperature = 0
        self.fault = ControllerState.FAULT_OK
        self.position_offset_dist = 0
        self.position_offset_ang = 0
        self.position_ang = 0
        self.position_distance = 0
        self.velocity_ang = 0
        self.velocity_distance = 0

    def set_values(self, state):
        self.stamp = time.time()
        self.mode = state.values[moteus.Register.MODE]
        self.position = (state.values[moteus.Register.POSITION] * RobotSpec.ROTATION_DISTANCE) - self.position_offset_dist
        self.velocity = state.values[moteus.Register.VELOCITY]
        self.torque = state.values[moteus.Register.TORQUE]
        self.voltage = state.values[moteus.Register.VOLTAGE]
        self.temperature = state.values[moteus.Register.TEMPERATURE]
        self.fault = state.values[moteus.Register.FAULT]
        self.position_ang = (state.values[moteus.Register.POSITION] * RobotSpec.MOT_RPS_TO_WHEEL_RAD) - self.position_offset_ang
        self.position_distance = (state.values[moteus.Register.POSITION] * RobotSpec.ROTATION_DISTANCE) - self.position_offset_dist
        self.velocity_ang = (state.values[moteus.Register.VELOCITY] * RobotSpec.MOT_RPS_TO_WHEEL_RAD) - self.position_offset_ang
        self.velocity_distance = (state.values[moteus.Register.VELOCITY] * RobotSpec.ROTATION_DISTANCE) - self.position_offset_dist

    def set_offset(self, state):
        self.position_offset_dist = (state.values[moteus.Register.POSITION] * RobotSpec.ROTATION_DISTANCE)
        self.position_offset_ang = (state.values[moteus.Register.POSITION] * RobotSpec.MOT_RPS_TO_WHEEL_RAD)

    def get_status_msg(self, side=1):  # side -1 left, 1 right
        msg = Moteus_controller_state()
        msg.id = self.id
        msg.mode = self.get_mode(self.mode)
        msg.position = self.position * side
        msg.velocity = self.velocity * RobotSpec.ROTATION_DISTANCE * side
        msg.torque = self.torque * RobotSpec.REDUCER * side
        msg.voltage = self.voltage
        msg.temperature = self.temperature
        msg.fault = self.get_fault(self.fault)
        return msg

    def get_mode(self, code):
        if code == ControllerState.MODE_STOPPED:
            return "STOPPED"
        elif code == ControllerState.MODE_FAULT:
            return "FAULT"
        elif code == ControllerState.MODE_PWM:
            return "PWM"
        elif code == ControllerState.MODE_VOLTAGE:
            return "VOLTAGE"
        elif code == ControllerState.MODE_VOLTAGE_FOC:
            return "VOLTAGE_FOC"
        elif code == ControllerState.MODE_VOLTAGE_DQ:
            return "VOLTAGE_DQ"
        elif code == ControllerState.MODE_CURRENT:
            return "CURRENT"
        elif code == ControllerState.MODE_POSITION:
            return "POSITION"
        elif code == ControllerState.MODE_TIMEOUT:
            return "TIMEOUT"
        elif code == ControllerState.MODE_ZERO_VELOCITY:
            return "ZERO_VELOCITY"
        elif code == ControllerState.MODE_STAY_WITHIN:
            return "STAY_WITHIN"
        else:
            return str(code)

    def get_fault(self, code):
        if code == ControllerState.FAULT_OK:
            return "OK"
        elif code == ControllerState.FAULT_CALIBRATION:
            return "CALIBRATION_FAULT"
        elif code == ControllerState.FAULT_MOTOR_DRV:
            return "MOTOR_DRV_FAULT"
        elif code == ControllerState.FAULT_OVER_VOLTAGE:
            return "OVER_VOLTAGE"
        elif code == ControllerState.FAULT_ENCODER:
            return "ENCODER_FAULT"
        elif code == ControllerState.FAULT_MOTOR_NOT_CONFG:
            return "MOTOR_NOT_CONFG"
        elif code == ControllerState.FAULT_PWM_CYCLE_OVERRUN:
            return "PWM_CYCLE_OVERRUN"
        elif code == ControllerState.FAULT_OVER_TEMP:
            return "OVER_TEMP"
        elif code == ControllerState.FAULT_OUTSIDE_LIMIT:
            return "OUTSIDE_LIMIT"
        else:
            return str(code)


class MotorController:
    def __init__(self, id_nr):
        self.id = id_nr
        self.c = None   # exists only while powered, see _open_transport
        self.state = ControllerState(self.id)
        self.velocity = 0


class BaseController:
    def __init__(self):
        self.c_front_left = MotorController(RobotSpec.FRONT_LEFT_ID)
        self.c_front_right = MotorController(RobotSpec.FRONT_RIGHT_ID)
        self.c_rear_left = MotorController(RobotSpec.REAR_LEFT_ID)
        self.c_rear_right = MotorController(RobotSpec.REAR_RIGHT_ID)

        # Configuration for each motor
        self.motor_configs = [
            {'obj': self.c_front_left,  'name': "FRONT_LEFT",  'vel_cmd_multiplier': -1, 'ros_name_prefix': 'front_left'},
            {'obj': self.c_front_right, 'name': "FRONT_RIGHT", 'vel_cmd_multiplier':  1, 'ros_name_prefix': 'front_right'},
            {'obj': self.c_rear_left,   'name': "REAR_LEFT",   'vel_cmd_multiplier': -1, 'ros_name_prefix': 'rear_left'},
            {'obj': self.c_rear_right,  'name': "REAR_RIGHT",  'vel_cmd_multiplier':  1, 'ros_name_prefix': 'rear_right'},
        ]

        # Motor command parameters (previously magic numbers)
        self.MOTOR_FF_TORQUE = -0.1  # Consider if this needs to be directional
        self.MOTOR_KP_SCALE = 2.0
        self.MOTOR_KD_SCALE = 1.0
        self.MOTOR_WATCHDOG_TIMEOUT = 0.5
        self.DEFAULT_MAX_TORQUE = RobotSpec.TORQUE # Default max torque from RobotSpec

        # This will be updated by the ROS thread in the background.
        self.lock = threading.Lock()
        self.current_request = None
        self.motors_switch = False
        self.motors_power_switch = None
        self.motors_switch_pub = None
        self.ros_ready = False
        self.controller_status = False
        # Boot policy: drive motor power stays OFF after node start until something
        # deliberately publishes True on /base/motor_power (~motors_on_at_start).
        self.motors_on_at_start = False
        self.pm_status_received = False   # first /pm/power_status seen
        self.start_stamp = time.time()
        # A latched True replayed by a publisher that outlived this node (respawn) is
        # a stale command, not a deliberate enable - ignored for this long after start.
        self.STALE_LATCH_IGNORE_S = 5.0
        # Motor power is one state machine (power_step): the last request wins, an
        # OFF always goes first, and an ON only runs through off -> on -> drives
        # answered. Drives and the CAN adapter are only touched while powered.
        #
        # Measured 31. 10. 2026, dock: drives answer 0.1-0.18 s after ON; after OFF the
        # rail falls 23.5 -> 7 V in 0.16 s. An ON into that fall, from position mode:
        # gap up to 0.08 s = fault 33 or TIMEOUT, cleared by a stop; gap up to 0.25 s =
        # about 3 in 90 all four drives silent, no stop or new port helps, one more
        # power cycle does. So OFF lasts at least min_off_s and a silent start gets
        # a full power cycle.
        self.POWER_ON_RETRY_S = 1.0
        self.POWER_ON_GIVE_UP_S = 10.0
        self.POWER_OFF_RETRY_S = 0.3
        self.MOTOR_REPLY_TIMEOUT_S = 0.3
        self.MIN_OFF_S = 2.0           # ~min_off_s
        self.BOOT_SETTLE_S = 0.5       # ~boot_settle_s, first CAN frame after power-on
        self.BOOT_TIMEOUT_S = 2.0      # ~boot_timeout_s, all four drives must answer
        self.BOOT_ATTEMPTS = 3         # ~boot_attempts, full off/on cycles
        self.MIN_RAIL_V = 16.0         # below it a drive is on a dying rail
        self.RUN_FAILS_REOPEN = 5      # bad cycles in a row before the port is reopened
        self.power_state = 'OFF'       # OFF, WAIT_OFF, PM_ON, BOOT, RUN, PM_OFF
        self.want_on = False
        self.force_off = True          # force the output OFF once at node start
        self.power_failed = None       # text of the failure to report
        self.boot_attempt = 0
        self.off_since = None          # wall clock of the confirmed OFF
        self.pm_on_since = None
        self.pm_sent = 0.0
        self.pm_off_since = None
        self.run_fails = 0
        self.transport = None
        self.pub_log_info = None
        self.pub_front_left_velocity = rospy.Publisher("/base/front_left_wheel_real_vel", Float32, queue_size=10)
        self.pub_front_right_velocity = rospy.Publisher("/base/front_right_wheel_real_vel", Float32, queue_size=10)
        self.pub_rear_left_velocity = rospy.Publisher("/base/rear_left_wheel_real_vel", Float32, queue_size=10)
        self.pub_rear_right_velocity = rospy.Publisher("/base/rear_right_wheel_real_vel", Float32, queue_size=10)
        self.pub_front_left_angle = rospy.Publisher("/base/front_left_wheel_angle", Float32, queue_size=10)
        self.pub_front_right_angle = rospy.Publisher("/base/front_right_wheel_angle", Float32, queue_size=10)
        self.pub_rear_left_angle = rospy.Publisher("/base/rear_left_wheel_angle", Float32, queue_size=10)
        self.pub_rear_right_angle = rospy.Publisher("/base/rear_right_wheel_angle", Float32, queue_size=10)
        self.pub_front_left_state = rospy.Publisher("/base/front_left_wheel_state", Moteus_controller_state, queue_size=10)
        self.pub_front_right_state = rospy.Publisher("/base/front_right_wheel_state", Moteus_controller_state, queue_size=10)
        self.pub_rear_left_state = rospy.Publisher("/base/rear_left_wheel_state", Moteus_controller_state, queue_size=10)
        self.pub_rear_right_state = rospy.Publisher("/base/rear_right_wheel_state", Moteus_controller_state, queue_size=10)
        self.timer_slow = None
        # Node shutdown (rosnode kill, SIGINT, SIGTERM, ROS thread end). Both the
        # asyncio loop and the ROS thread watch it so the process really exits and
        # roslaunch can respawn it.
        self.shutdown_event = threading.Event()
        self.SHUTDOWN_HARD_EXIT_S = 3.0

    def should_exit(self):
        return self.shutdown_event.is_set() or rospy.is_shutdown()

    def request_shutdown(self, reason):
        """Idempotent; safe from any thread / signal handler. Never powers anything ON."""
        if self.shutdown_event.is_set():
            return
        self.shutdown_event.set()
        try:
            rospy.loginfo("Node base_controller shutting down (%s)..." % reason)
        except Exception:
            pass
        # Last resort: if something blocks synchronously, do not hang forever
        # (motor drivers have a 0.5 s watchdog, power module output is commanded OFF).
        def hard_exit():
            time.sleep(self.SHUTDOWN_HARD_EXIT_S)
            sys.stderr.write("base_controller: shutdown timed out, forcing exit\n")
            sys.stderr.flush()
            os._exit(1)
        threading.Thread(target=hard_exit, name="shutdown_watchdog", daemon=True).start()

    def publish_motor_switch_off(self):
        """Best effort: command the power module motor output OFF."""
        pub = self.motors_switch_pub
        if pub is None:
            return
        try:
            pub.publish(Bool(data=False))
            time.sleep(0.2)  # let the publisher thread flush before topics close
        except Exception as e:
            sys.stderr.write("base_controller: motor power OFF publish failed: %s\n" % e)

    async def _reply(self, call):
        """A moteus call that cannot block the controller loop."""
        return await asyncio.wait_for(call, self.MOTOR_REPLY_TIMEOUT_S)

    async def stop_motors(self, timeout=0.3):
        """Best effort set_stop on every drive, bounded so it cannot block exit."""
        for config in self.motor_configs:
            c = config['obj'].c
            if not c:
                continue
            try:
                await asyncio.wait_for(c.set_stop(), timeout)
            except Exception as e:
                sys.stderr.write("base_controller: stop motor %s failed: %r\n" % (config['name'], e))

    # ---- CAN adapter --------------------------------------------------------
    def _close_transport(self):
        """Drop the port: nothing queues for an unpowered bus and a stream that
        lost sync (a late reply after a timeout) cannot carry over."""
        t, self.transport = self.transport, None
        for config in self.motor_configs:
            config['obj'].c = None
        if t is None:
            return
        try:
            serial_port = t._serial
            asyncio.get_event_loop().remove_reader(serial_port.fd)
            serial_port.serial.close()
        except Exception as e:
            rospy.logwarn("base_controller: closing CAN adapter failed: %r" % (e,))

    def _open_transport(self):
        self._close_transport()
        self.transport = moteus.Fdcanusb()
        for config in self.motor_configs:
            config['obj'].c = moteus.Controller(config['obj'].id, transport=self.transport)

    # ---- power state machine -------------------------------------------------
    def _set_power_state(self, state):
        if state != self.power_state:
            rospy.loginfo("Motor power: %s -> %s" % (self.power_state, state))
        self.power_state = state

    def _fail(self, text):
        rospy.logerr(text)
        if self.pub_log_info is not None:
            self.pub_log_info.publish(String(text))

    def _zero_commands(self):
        with self.lock:
            for config in self.motor_configs:
                config['obj'].velocity = 0.0

    async def _begin_off(self):
        """Into PM_OFF from any state: drives stopped, port closed, ON no more."""
        with self.lock:
            self.controller_status = False
        self._zero_commands()
        if self.transport is not None:
            await self.stop_motors()
        self._close_transport()
        self.pm_off_since = time.time()
        self.pm_sent = 0.0
        self._set_power_state('PM_OFF')

    def _pm_off_step(self, now):
        """OFF is repeated until the power module reports it, however long."""
        # Always sent at least once: a just-failed ON may still reach the module.
        if self.pm_sent > 0.0 and not self.motors_switch and self.pm_status_received:
            rospy.loginfo("Motor power output disabled.")
            self.off_since = now
            self.force_off = False
            self._set_power_state('OFF')
            return
        if now - self.pm_sent >= self.POWER_OFF_RETRY_S:
            self.motors_switch_pub.publish(Bool(data=False))
            self.pm_sent = now
            if now - self.pm_off_since >= 5.0:
                rospy.logerr_throttle(10.0, "Power module does not confirm motor power OFF.")

    def _pm_on_step(self, now):
        if self.motors_switch:
            rospy.loginfo("Motor power output enabled (%.2f s)." % (now - self.pm_on_since))
            self.pm_on_since = now
            self._zero_commands()
            self._set_power_state('BOOT')
            return False
        if now - self.pm_on_since >= self.POWER_ON_GIVE_UP_S:
            self.boot_attempt = self.BOOT_ATTEMPTS
            self.power_failed = ("Motors did not power on - no answer from power module")
            return True
        if now - self.pm_sent >= self.POWER_ON_RETRY_S:
            rospy.logwarn("Still waiting for Power module enable motor power output...")
            self.motors_switch_pub.publish(Bool(data=True))
            self.pm_sent = now
        return False

    async def _boot(self):
        """Powered: every drive must answer on a live rail, faults cleared.
        Returns True when all four are ready; a False means a new full cycle."""
        started = self.pm_on_since
        while time.time() - started < self.BOOT_SETTLE_S:
            if not self.want_on or self.should_exit():
                return False
            await asyncio.sleep(0.02)
        pending = list(self.motor_configs)
        detail = {}
        while pending:
            if not self.want_on or self.should_exit():
                return False
            if time.time() - started >= self.BOOT_TIMEOUT_S:
                self.power_failed = "Motors not answering after power-on: %s" % ", ".join(
                    "%s (%s)" % (c['name'], detail.get(c['name'], 'no reply')) for c in pending)
                return False
            try:
                if self.transport is None:
                    self._open_transport()
            except Exception as e:
                detail = {c['name']: 'CAN adapter: %r' % (e,) for c in pending}
                await asyncio.sleep(0.2)
                continue
            for config in list(pending):
                try:
                    c = config['obj'].c
                    await self._reply(c.set_stop())   # also clears a latched fault
                    state = await self._reply(c.query())
                except Exception as e:
                    # A late reply would be read as the answer to the next command.
                    detail[config['name']] = 'no reply' if isinstance(
                        e, asyncio.TimeoutError) else repr(e)
                    self._close_transport()
                    break
                if not state:
                    detail[config['name']] = 'empty reply'
                    continue
                voltage = state.values[moteus.Register.VOLTAGE]
                fault = state.values[moteus.Register.FAULT]
                mode = state.values[moteus.Register.MODE]
                if fault != ControllerState.FAULT_OK or voltage < self.MIN_RAIL_V:
                    detail[config['name']] = 'mode %s fault %s %.1f V' % (mode, fault, voltage)
                    continue
                rospy.loginfo("Motor %s ready %.2f s after power-on (%.1f V, mode %s)."
                              % (config['name'], time.time() - started, voltage, mode))
                with self.lock:
                    config['obj'].state.set_values(state)
                pending.remove(config)
            await asyncio.sleep(0.05)
        return True

    async def _run_cycle(self):
        """One velocity command + state read per drive. Failures are reported and
        left to safety_node (no data -> OFF): power is never cycled under a moving
        robot, and motors never come back on by themselves."""
        with self.lock:
            current_max_torque = RobotSpec.torque_recent if RobotSpec.torque_recent > 0 else self.DEFAULT_MAX_TORQUE
        all_ok = True
        for config in self.motor_configs:
            motor_obj = config['obj']
            if not motor_obj.c:
                all_ok = False
                continue
            with self.lock:  # velocity is set by ROS callbacks
                # Target wheel velocity (rad/s) to motor velocity (RPS)
                motor_target_rps = motor_obj.velocity * RobotSpec.WHEEL_RAD_TO_MOT_RPS * config['vel_cmd_multiplier']
            try:
                await self._reply(motor_obj.c.set_position(
                    position=math.nan,  # Position control mode, but target is velocity
                    velocity=motor_target_rps,
                    feedforward_torque=self.MOTOR_FF_TORQUE,
                    kp_scale=self.MOTOR_KP_SCALE,
                    kd_scale=self.MOTOR_KD_SCALE,
                    maximum_torque=current_max_torque,
                    stop_position=None,  # No specific stop position for pure velocity control
                    watchdog_timeout=self.MOTOR_WATCHDOG_TIMEOUT,
                    query=False))
                state_data = await self._reply(motor_obj.c.query())
                if state_data:
                    with self.lock:
                        motor_obj.state.set_values(state_data)
                    # Our own loop paused past the drive watchdog (23. 8. 2026: two
                    # wheels sat in TIMEOUT on a live rail). The drive leaves that
                    # mode only through a stop, the next command then resumes.
                    if state_data.values[moteus.Register.MODE] == ControllerState.MODE_TIMEOUT:
                        rospy.logwarn_throttle(2.0, "Motor %s watchdog timeout - stop to resume." % config['name'])
                        await self._reply(motor_obj.c.set_stop())
                else:
                    all_ok = False
            except Exception as e:
                all_ok = False
                rospy.logerr_throttle(2.0, f"Error commanding/querying motor {motor_obj.id} ({config['name']}): {e!r}")
                break
        self.run_fails = 0 if all_ok else self.run_fails + 1
        if self.run_fails >= self.RUN_FAILS_REOPEN:
            self.run_fails = 0
            rospy.logwarn("Motor bus not answering - reopening the CAN adapter.")
            try:
                self._open_transport()
            except Exception as e:
                rospy.logerr_throttle(2.0, "Reopening the CAN adapter failed: %r" % (e,))

    async def power_step(self, now):
        state = self.power_state
        if state == 'PM_OFF':
            self._pm_off_step(now)
            return
        if self.force_off or not self.want_on:
            if state != 'OFF' or self.force_off or (self.motors_switch and self.pm_status_received):
                await self._begin_off()    # also catches an ON from elsewhere
            return
        if state == 'OFF':
            self.boot_attempt = max(self.boot_attempt, 1)
            self._set_power_state('WAIT_OFF')
            return
        if state == 'WAIT_OFF':
            if self.off_since is None or now - self.off_since >= self.MIN_OFF_S:
                self.motors_switch_pub.publish(Bool(data=True))
                self.pm_on_since = self.pm_sent = now
                rospy.loginfo("Wait for Power module enable motor power output... (attempt %d)"
                              % self.boot_attempt)
                self._set_power_state('PM_ON')
            return
        give_up = False
        if state == 'PM_ON':
            give_up = self._pm_on_step(now)
        elif state == 'BOOT':
            if await self._boot():
                with self.lock:
                    self.controller_status = True
                self.boot_attempt = 0
                self.run_fails = 0
                rospy.loginfo("Controller started.")
                self._set_power_state('RUN')
                return
            if not self.want_on or self.should_exit():
                return
            give_up = True
        elif state == 'RUN':
            await self._run_cycle()
            return
        if not give_up:
            return
        # A failed try: the full cycle (real OFF, min_off_s, ON). A second cause of
        # a dead start is what only a full power-off cures.
        if self.boot_attempt < self.BOOT_ATTEMPTS:
            rospy.logwarn("%s - power cycle, attempt %d of %d." % (
                self.power_failed, self.boot_attempt + 1, self.BOOT_ATTEMPTS))
            self.boot_attempt += 1
        else:
            self._fail(self.power_failed)
            self.boot_attempt = 0
            with self.lock:
                self.want_on = False
        self.power_failed = None
        await self._begin_off()

    async def run(self):
        while not self.motors_switch_pub or not self.ros_ready:
            if self.should_exit():
                return
            await asyncio.sleep(0.05)
        while not self.should_exit():
            await self.power_step(time.time())
            await asyncio.sleep(0.01)
        # Leaving on shutdown: drives to stop (power output is commanded OFF by the
        # pre-shutdown hook). Nothing is enabled here.
        if self.transport is not None:
            await self.stop_motors()

    def publish_velocity(self):
        ## Publish controllers velocities
        msg = Float32()
        msg.data = self.c_front_left.state.velocity_ang * -1
        self.pub_front_left_velocity.publish(msg)
        msg.data = self.c_front_right.state.velocity_ang
        self.pub_front_right_velocity.publish(msg)
        msg.data = self.c_rear_left.state.velocity_ang * -1
        self.pub_rear_left_velocity.publish(msg)
        msg.data = self.c_rear_right.state.velocity_ang
        self.pub_rear_right_velocity.publish(msg)

    def publish_position(self):
        ## Publish controllers positions
        msg = Float32()
        msg.data = self.c_front_left.state.position_ang * -1
        self.pub_front_left_angle.publish(msg)
        msg.data = self.c_front_right.state.position_ang
        self.pub_front_right_angle.publish(msg)
        msg.data = self.c_rear_left.state.position_ang * -1
        self.pub_rear_left_angle.publish(msg)
        msg.data = self.c_rear_right.state.position_ang
        self.pub_rear_right_angle.publish(msg)

    def publish_state(self):
        ## Publish controllers state
        is_valid = time.time() - self.c_front_left.state.stamp
        if (is_valid < 1):
            msg = self.c_front_left.state.get_status_msg(-1)
            msg.header.stamp = rospy.Time.now()
            msg.name = "FRONT_LEFT"
            self.pub_front_left_state.publish(msg)
        is_valid = time.time() - self.c_front_right.state.stamp
        if (is_valid < 1):
            msg = self.c_front_right.state.get_status_msg(1)
            msg.header.stamp = rospy.Time.now()
            msg.name = "FRONT_RIGHT"
            self.pub_front_right_state.publish(msg)
        is_valid = time.time() - self.c_rear_left.state.stamp
        if (is_valid < 1):
            msg = self.c_rear_left.state.get_status_msg(-1)
            msg.header.stamp = rospy.Time.now()
            msg.name = "REAR_LEFT"
            self.pub_rear_left_state.publish(msg)
        is_valid = time.time() - self.c_rear_right.state.stamp
        if (is_valid < 1):
            msg = self.c_rear_right.state.get_status_msg(1)
            msg.header.stamp = rospy.Time.now()
            msg.name = "REAR_RIGHT"
            self.pub_rear_right_state.publish(msg)



    def _request(self, on, msg):
        with self.lock:
            changed = on != self.want_on
            self.want_on = on
        if changed:
            header = getattr(msg, '_connection_header', None) or {}
            rospy.loginfo("Motor power request %s from %s" % ('ON' if on else 'OFF', header.get('callerid', '?')))

    def callback_motor_power(self, msg):
        if msg.data:
            # Right after (re)start a latched publisher replays its LAST command.
            # That is history (e.g. the undock hours ago), not a deliberate enable.
            header = getattr(msg, '_connection_header', None) or {}
            if (not self.motors_on_at_start
                    and header.get('latching') == '1'
                    and (time.time() - self.start_stamp) < self.STALE_LATCH_IGNORE_S):
                rospy.logwarn("Ignoring latched motor power ON replayed at node start "
                              "(from %s). Motors stay OFF." % header.get('callerid', '?'))
                return
            self._request(True, msg)
        else:
            self._request(False, msg)

    def callback_set_torque(self, msg):
        with self.lock:
            RobotSpec.torque_recent = msg.data / RobotSpec.REDUCER
        with self.lock:
            RobotSpec.TORQUE = msg.data / RobotSpec.REDUCER

    def callback_front_left_vel(self, msg):
        with self.lock:
            self.c_front_left.velocity = msg.data

    def callback_front_right_vel(self, msg):
        with self.lock:
            self.c_front_right.velocity = msg.data

    def callback_rear_left_vel(self, msg):
        with self.lock:
            self.c_rear_left.velocity = msg.data

    def callback_rear_right_vel(self, msg):
        with self.lock:
            self.c_rear_right.velocity = msg.data

    def callback_power_status(self, msg):
        with self.lock:
            self.motors_switch = msg.motor_out_switch
            self.pm_status_received = True

    # Stop controller if motor output switch off message for power module is received.
    def callback_pm_set_motor_switch(self, msg):
        # Our own commands come back here; a command from elsewhere (power panel,
        # e-stop) is a request like /base/motor_power, so the drives follow it.
        header = getattr(msg, '_connection_header', None) or {}
        if header.get('callerid') == rospy.get_name():
            return
        self._request(bool(msg.data), msg)

async def main():
    controller = BaseController()

    # Start ROS in a thread separate from the asyncio one.
    def start_ros():
        try:
            ros_loop()
        except rospy.ROSInterruptException:
            pass
        except Exception:
            traceback.print_exc()
            rospy.logerr("base_controller ROS thread failed!")
        finally:
            # Whatever ended the ROS side (rosnode kill, signal, crash) ends the node.
            controller.request_shutdown("ROS thread finished")
            if not rospy.is_shutdown():
                rospy.signal_shutdown("ROS thread finished")

    def ros_loop():
        # Publisher to motor switch on the power module and subscriber for motor switch check.
        controller.motors_switch_pub = rospy.Publisher("/pm/set_motor_switch", Bool, queue_size=10)
        controller.motors_power_switch = rospy.Subscriber('/pm/power_status', Power_status, controller.callback_power_status)

        rospy.init_node('base_controller', disable_signals=True)

        # rosnode kill / signal_shutdown: runs before topics close, so the OFF still
        # reaches the power module; also wakes the asyncio loop (exit + respawn).
        def on_preshutdown(reason):
            controller.request_shutdown(reason)
            controller.publish_motor_switch_off()
        rospy.core.add_preshutdown_hook(on_preshutdown)
        rospy.Subscriber('/base/front_left_wheel_vel', Float32, controller.callback_front_left_vel)
        rospy.Subscriber('/base/front_right_wheel_vel', Float32, controller.callback_front_right_vel)
        rospy.Subscriber('/base/rear_left_wheel_vel', Float32, controller.callback_rear_left_vel)
        rospy.Subscriber('/base/rear_right_wheel_vel', Float32, controller.callback_rear_right_vel)

        rospy.Subscriber('/base/motor_power', Bool, controller.callback_motor_power)
        pub_motor_power_state = rospy.Publisher("/base/motor_power_state", Bool, queue_size=10)

        rospy.Subscriber('/base/set_torque', Float32, controller.callback_set_torque)
        pub_get_torque_set = rospy.Publisher("/base/get_torque_set", Float32, queue_size=10)

        rospy.Subscriber('/pm/set_motor_switch', Bool, controller.callback_pm_set_motor_switch)
        rate = 50
        r = rospy.Rate(rate)  # Hz

        # Motor power after node start (boot, stack restart, respawn). Default False:
        # the power module output is forced OFF and stays OFF until a True arrives
        # on /base/motor_power. True restores the legacy power-cycle-and-enable.
        controller.motors_on_at_start = bool(rospy.get_param('~motors_on_at_start', False))
        # Cmd while motors are off -> tell the user instead of silently not moving.
        pub_log_info = rospy.Publisher('/nextion/log_info', String, queue_size=10)
        controller.pub_log_info = pub_log_info
        cmd_while_off_since = None
        cmd_while_off_warned = 0.0

        controller.MIN_OFF_S = float(rospy.get_param('~min_off_s', controller.MIN_OFF_S))
        controller.BOOT_SETTLE_S = float(rospy.get_param('~boot_settle_s', controller.BOOT_SETTLE_S))
        controller.BOOT_TIMEOUT_S = float(rospy.get_param('~boot_timeout_s', controller.BOOT_TIMEOUT_S))
        controller.BOOT_ATTEMPTS = int(rospy.get_param('~boot_attempts', controller.BOOT_ATTEMPTS))
        slow_counter = 0
        slow_limit = rate/2 ## 2x per second ToDo: refactor to timer
        # The first OFF must really reach the power module: wait (bounded) until it
        # reports, or a switch left ON by a killed predecessor would go unnoticed.
        wait_start = time.time()
        while (not controller.pm_status_received and not rospy.is_shutdown()
               and (time.time() - wait_start) < 10.0):
            time.sleep(0.1)
        if not controller.pm_status_received:
            rospy.logwarn("No /pm/power_status yet - motor power OFF not verified.")
        if controller.motors_on_at_start:
            with controller.lock:
                controller.want_on = True
        controller.ros_ready = True
        rospy.loginfo("Moteus controller initialized.")
        while not controller.should_exit():

            ## Publish controllers positions
            controller.publish_position()
            ## Publish controllers velocities
            controller.publish_velocity()
            ## Publish controllers states
            if (slow_limit == slow_counter):
                controller.publish_state()
                slow_counter = 0
            slow_counter +=1

            #### over all status ####################
            new_msg = Bool()
            overall_status_ok = True # Assume OK initially

            if not controller.controller_status: # If controller itself is not active
                overall_status_ok = False
            elif RobotSpec.torque_recent == 0.0: # If torque is set to zero (motors might be intentionally disabled)
                overall_status_ok = False
            else:
                # Check each motor's state using motor_configs
                for config in controller.motor_configs:
                    motor_state = config['obj'].state
                    with controller.lock: # Ensure thread-safe access to motor_state
                        if motor_state.fault != ControllerState.FAULT_OK or \
                           motor_state.mode != ControllerState.MODE_POSITION: # Assuming MODE_POSITION is the desired operational mode
                            overall_status_ok = False
                            break # A single motor fault or wrong mode makes overall status not OK
            
            new_msg.data = overall_status_ok
            pub_motor_power_state.publish(new_msg)

            #### velocity commanded into unpowered motors -> user-facing message ####
            # Nothing here powers the motors (fail safe); whoever starts motion has to
            # enable them deliberately. Without this the robot just "does nothing".
            with controller.lock:
                cmd_active = any(abs(config['obj'].velocity) > 0.05
                                 for config in controller.motor_configs)
            if cmd_active and not controller.controller_status and not controller.want_on:
                now = time.time()
                if cmd_while_off_since is None:
                    cmd_while_off_since = now
                elif (now - cmd_while_off_since) > 1.0 and (now - cmd_while_off_warned) > 5.0:
                    cmd_while_off_warned = now
                    rospy.logwarn("Velocity command received but drive motors are OFF - "
                                  "not moving. Enable motor power (/base/motor_power).")
                    pub_log_info.publish(String("Motors are OFF - turn motors on to move"))
            else:
                cmd_while_off_since = None

            new_msg = Float32()
            new_msg.data = RobotSpec.torque_recent * RobotSpec.REDUCER
            pub_get_torque_set.publish(new_msg)

            r.sleep()

    ros_thread = threading.Thread(target=start_ros, name="ros_loop", daemon=True)
    ros_thread.start()

    # SIGINT/SIGTERM (rospy signals are disabled): only flag the shutdown here, the
    # actual ROS shutdown (incl. motor power OFF) runs outside the signal context.
    loop = asyncio.get_event_loop()
    for sig in (signal.SIGINT, signal.SIGTERM):
        loop.add_signal_handler(sig, controller.request_shutdown, signal.Signals(sig).name)

    # Run Moteus in asyncio
    run_task = asyncio.ensure_future(controller.run())
    failed = False
    while not run_task.done() and not controller.should_exit():
        await asyncio.sleep(0.05)
    if not run_task.done():
        # run() sees the flag within one cycle; cancel if it does not finish in time.
        done, _ = await asyncio.wait({run_task}, timeout=1.0)
        if not done:
            run_task.cancel()
            await asyncio.wait({run_task}, timeout=0.3)
            await controller.stop_motors(timeout=0.1)
    if run_task.done() and not run_task.cancelled() and run_task.exception() is not None:
        e = run_task.exception()
        print(e)
        traceback.print_exception(type(e), e, e.__traceback__)
        rospy.logerr("Moteus controller failed!")
        failed = True

    controller.request_shutdown("controller loop finished")
    if not rospy.is_shutdown():
        # Runs the pre-shutdown hook -> motor power OFF; off the loop thread so a
        # slow rospy teardown cannot stall us beyond the hard-exit watchdog.
        sd = threading.Thread(target=rospy.signal_shutdown, args=("end",), daemon=True)
        sd.start()
        sd.join(1.0)
    ros_thread.join(1.0)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))
