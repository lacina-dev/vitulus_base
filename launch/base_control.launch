<launch>
    <arg name="run_description" default="false"/>

    <group if="$(arg run_description)">
        <include file="$(find vitulus_description)/launch/vitulus4wd.launch">
            <arg name="rviz" value="true"/>
        </include>
    </group>

	<!-- Vitulus model -->
	<param name="robot_description" command="$(find xacro)/xacro '$(find vitulus_description)/urdf/vitulus4WD_description.urdf.xacro' --inorder" />

    <!-- cmd_vel_mux (18. 10. 2026): a person on the controls beats the software.
         The diff_drive controller listens on its own /mobile_base_controller/cmd_vel
         and ONLY the mux publishes there: DS4 (/ds4/cmd_vel) > web joystick / keyboard
         (/teleop/cmd_vel) > all software (/cmd_vel: MBF, docking, mower recovery,
         agent supervisor). A deflected stick cancels the software's goals once;
         centred-stick zeros never block the software. See nodes/cmd_vel_mux.
         If the mux is not running nothing reaches the wheels - the robot stands.
         cmd_vel_mux:=false = the old behaviour (everything straight on /cmd_vel). -->
    <arg name="cmd_vel_mux" default="true"/>
    <node name="vitulus_base_node" pkg="vitulus_base" type="vitulus_base_node">
        <remap from="/mobile_base_controller/cmd_vel" to="/cmd_vel" unless="$(arg cmd_vel_mux)"/>
    </node>
    <node name="cmd_vel_mux" pkg="vitulus_base" type="cmd_vel_mux" output="screen"
          respawn="true" respawn_delay="1" if="$(arg cmd_vel_mux)"/>



    <!-- Controller -->
    <rosparam command="load" file="$(find vitulus_base)/config/base_common.yaml"/>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" output="screen"
          args="joint_state_controller
          mobile_base_controller"/>

    <!-- HW Controller -->
    <!-- motors_on_at_start: drive motor power after EVERY start of this node (boot, stack
         restart, respawn). false (default, safe) = the power-module motor output is forced
         OFF and stays OFF until something deliberately publishes True on /base/motor_power
         (UI / display button, dock_smach undock, docking controller). true = legacy
         behaviour (power-cycle and enable the motors right after start). -->
    <arg name="motors_on_at_start" default="false"/>
    <node pkg="vitulus_base" type="base_controller" name="base_controller" output="screen" respawn="true">
        <param name="motors_on_at_start" value="$(arg motors_on_at_start)"/>
    </node>


</launch>